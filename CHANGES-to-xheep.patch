+++ b/core-v-mini-mcu.core
@@ -386,6 +386,7 @@ targets:
           - '--trace-max-array 1024'
           - '--x-assign unique'
           - '--x-initial unique'
+          - '+define+COPROC_FPU_SHARE'
           - '--exe tb_top.cpp'
           - '-CFLAGS "-Wall -fpermissive"'
           - '-LDFLAGS "-pthread -lutil -lelf"'
